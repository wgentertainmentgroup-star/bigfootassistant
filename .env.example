# Bigfoot's Day companion service
# Copy these values into your launch environment. Never commit your real API key.
OPENAI_API_KEY=your_openai_api_key_here
BIGFOOT_COMPANION_TOKEN=choose_a_private_connection_code
BIGFOOT_PORT=8787
BIGFOOT_MODEL=gpt-5.6

# Google connection for Gmail + Calendar.
# Register this exact redirect URI in the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/google/callback

# Optional separate secret for encrypting saved Google refresh tokens.
# If omitted, BIGFOOT_COMPANION_TOKEN is used.
# BIGFOOT_TOKEN_KEY=use_a_long_random_secret

# Optional: Responses API MCP connector configurations.
# Keep OAuth/access tokens only on the companion service.
# BIGFOOT_MCP_TOOLS_JSON=[{"type":"mcp","server_label":"example","server_url":"https://example.com/mcp","authorization":"...","require_approval":"always"}]
