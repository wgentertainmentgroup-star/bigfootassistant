# Public service address injected into the Android web bundle by GitHub Actions.
VITE_BIGFOOT_API_BASE=https://bigfoots-day-private.example.workers.dev

# A random installation token. This is not the OpenAI or Google secret.
VITE_BIGFOOT_APP_TOKEN=replace-with-a-long-random-installation-token

# Cloudflare Worker secrets (configure in Cloudflare; never commit values):
# OPENAI_API_KEY
# BIGFOOT_APP_TOKEN
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
